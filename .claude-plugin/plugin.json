{
  "name": "simplify3x-connect",
  "displayName": "simplify3x-connect",
  "version": "0.28.1",
  "description": "Find, write, record, run and triage SimplifyQA test cases, suites, executions and defects from Claude",
  "author": {
    "name": "Simplify3x",
    "url": "https://simplifyqa.ai"
  },
  "homepage": "https://simplifyqa.ai",
  "repository": "https://github.com/Simplify3x/simplify3x-connect",
  "license": "MIT",
  "keywords": [
    "simplifyqa",
    "simplify3x",
    "qa",
    "testing",
    "test-automation",
    "test-management"
  ],
  "icon": "./logo.png",
  "documentationUrl": "https://github.com/Simplify3x/simplify3x-connect#readme",
  "supportUrl": "https://docs.simplifyqa.ai/need-support-connect-with-us",
  "privacyPolicyUrl": "https://simplifyqa.ai/privacy",
  "termsOfServiceUrl": "https://docs.simplifyqa.ai/legal-documents/end-user-license-agreement",
  "mcpServers": {
    "simplify3x-connect": {
      "command": "npx",
      "args": [
        "-y",
        "simplify3x-connect@0.28.1"
      ],
      "env": {
        "QA_MCP_PROVIDER": "simplifyqa",
        "QA_BASE_URL": "${user_config.base_url}",
        "QA_MCP_TOKEN": "${user_config.token}",
        "QA_MCP_PROJECT_ID": "${user_config.project_id}",
        "QA_MCP_URL": "${user_config.agent_url}"
      }
    }
  },
  "userConfig": {
    "base_url": {
      "type": "string",
      "title": "SimplifyQA URL",
      "description": "Your SimplifyQA workspace URL, for example https://app.simplifyqa.ai",
      "required": true
    },
    "token": {
      "type": "string",
      "title": "API token",
      "description": "API token from your SimplifyQA profile",
      "sensitive": true,
      "required": true
    },
    "project_id": {
      "type": "string",
      "title": "Default project ID",
      "description": "Optional. The SimplifyQA project to use when none is given",
      "default": ""
    },
    "agent_url": {
      "type": "string",
      "title": "Local agent URL",
      "description": "Optional. Only for live recording, for example http://127.0.0.1:4050/mcp",
      "default": ""
    }
  }
}
