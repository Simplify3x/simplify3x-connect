# ---- required ----
# Which backend to drive. This package supports two, so it must be explicit.
QA_MCP_PROVIDER=simplifyqa
# Your SimplifyQA URL. Everything except recording talks to it directly.
QA_BASE_URL=https://simplifyqa.example.com
# API token. Raw value, no "Bearer" prefix. Load it from Vault in a deployment.
QA_MCP_TOKEN=

# Optional: pin a default project. Omit and the assistant asks which one to use.
# QA_MCP_PROJECT_ID=

# ---- hosting (HTTP mode) ----
# 0.0.0.0 inside a container; 127.0.0.1 is only reachable from inside it.
HOST=0.0.0.0
PORT=4060
# Shared deployment: each session keeps its own drafts and project, the server never reads or writes
# files for a caller, and report_download returns the SimplifyQA report link. Off by default.
QA_MCP_HOSTED=true
# Per-user mode: every caller sends their own SimplifyQA key (Authorization: Bearer <key>), and the
# server connects as that caller. QA_MCP_TOKEN and QA_MCP_USER_ID are then ignored (leave them empty);
# QA_BASE_URL is required.
# QA_MCP_REQUIRE_CLIENT_TOKEN=true
# Shared secret on /mcp. Omit when an authenticating proxy already fronts the service.
# QA_MCP_GATEWAY_TOKEN=
# Only these hosts may be called from the server (subdomains included). Strongly recommended.
QA_MCP_ALLOWED_HOSTS=simplifyqa.example.com

# ---- everything else has a code default ----
# Tool families, HTTP timeout, session TTL, session/body limits and value resolution are defined in
# src/defaults.ts and can be overridden only if you really need to:
#   QA_MCP_CAPS, QA_HTTP_TIMEOUT_MS, QA_MCP_SESSION_TTL_MS, QA_MCP_MAX_SESSIONS,
#   QA_MCP_MAX_BODY_BYTES, QA_MCP_SQA_RESOLVE
#
# Desktop installs only, for recording:
#   QA_MCP_URL=http://127.0.0.1:4050/mcp
