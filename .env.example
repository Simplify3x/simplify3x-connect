# ---- gateway ----
# HOST must be 0.0.0.0 inside a container (127.0.0.1 is only reachable from inside it).
HOST=0.0.0.0
PORT=4060

# ---- QA connection ----
# walnut | simplifyqa
QA_MCP_PROVIDER=simplifyqa
QA_BASE_URL=https://app.simplifyqa.ai
# Local agent /mcp, for recording. host.docker.internal reaches the Docker host.
QA_MCP_URL=http://host.docker.internal:4040/mcp
QA_MCP_TOKEN=
QA_MCP_PROJECT_ID=1
QA_MCP_USER_ID=
